# Copy this file to `keystore.properties` and fill in your values to produce a
# signed release build. `keystore.properties` and *.jks are git-ignored — never
# commit real signing secrets.
#
# Generate a keystore first:
#   keytool -genkey -v -keystore looking-glass-release.jks -alias lookingglass \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=../looking-glass-release.jks
storePassword=CHANGE_ME
keyAlias=lookingglass
keyPassword=CHANGE_ME
