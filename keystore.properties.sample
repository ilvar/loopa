# Copy this file to `keystore.properties` and fill in your values to produce a
# signed release build. `keystore.properties` and *.jks are git-ignored — never
# commit real signing secrets.
#
# Generate a keystore first:
#   keytool -genkey -v -keystore loopa-release.jks -alias loopa \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=../loopa-release.jks
storePassword=CHANGE_ME
keyAlias=loopa
keyPassword=CHANGE_ME
